# Cole este conteúdo em: Streamlit Cloud > seu app > Settings > Secrets
# Para rodar localmente, salve como .streamlit/secrets.toml (este arquivo NUNCA vai para o GitHub).

# ─── IA (qualquer API compatível com OpenAI) ───────────────────────────────
LLM_API_KEY = " "
LLM_BASE_URL = "https://dashscope-intl.aliyuncs.com/compatible-mode/v1"  # Qwen internacional
LLM_MODEL = "qwen-plus"
# Outras opções de endpoint do Qwen:
#   EUA (Virgínia):    https://dashscope-us.aliyuncs.com/compatible-mode/v1
#   China continental: https://dashscope.aliyuncs.com/compatible-mode/v1
# Para usar um provedor homologado pela sua empresa (ex.: Azure OpenAI), basta trocar estes 3 valores.

# ─── Aplicação ─────────────────────────────────────────────────────────────
APP_URL = "https://caselab.streamlit.app"
CONTATO_PRIVACIDADE = "o RH ou o DPO da sua organização"

# Banco permanente (recomendado). Sem isto, usa SQLite local, que é apagado
# quando o app reinicia no Streamlit Cloud. Ex.: Supabase ou Neon (gratuitos).
# DATABASE_URL = "postgresql://usuario:senha@host:5432/postgres?sslmode=require"

# ─── Acesso — MODO DEMONSTRAÇÃO (padrão) ──────────────────────────────────
# Área restrita protegida por senha. Use senhas longas e exclusivas.
GESTOR_SENHA = "ADM123"
# Com TD_SENHA definida, toda trilha passa pela revisão da área de T&D antes de ser publicada.
# Sem ela, o próprio gestor publica e cuida da biblioteca.
TD_SENHA = "TD123"

# ─── Acesso — MODO CORPORATIVO (SSO, recomendado em produção) ─────────────
# Ao incluir a seção [auth], todos entram com a conta Microsoft da empresa
# e a senha acima deixa de ser usada. Configuração feita pela TI no Microsoft Entra ID.
# GESTORES_EMAILS = ["gestora@empresa.com.br", "gerente@empresa.com.br"]
# TD_EMAILS = ["td@empresa.com.br"]
# DOMINIOS_PERMITIDOS = ["empresa.com.br"]
#
# [auth]
# redirect_uri = "https://seu-app.streamlit.app/oauth2callback"
# cookie_secret = "gere-um-texto-aleatorio-longo"
# client_id = "id-do-aplicativo-no-entra"
# client_secret = "segredo-do-aplicativo"
# server_metadata_url = "https://login.microsoftonline.com/<ID-DO-TENANT>/v2.0/.well-known/openid-configuration"

# ─── Limites ───────────────────────────────────────────────────────────────
MAX_MENTORIAS_DIA = 10     # mentorias por participante por dia
MAX_GERACOES_SESSAO = 15   # usos da IA na criação de trilhas, por sessão
RITMO_ATIPICO_CPM = 400    # acima disso (caracteres/min), a proposta é sinalizada ao gestor

# ─── Canais do Teams (Workflows > "Postar em um canal quando uma solicitação de webhook for recebida")
# [teams_canais]
# "Suporte N2" = "https://prod-00.westus.logic.azure.com/workflows/..."
# "Atendimento" = "https://....environment.api.powerplatform.com/..."
